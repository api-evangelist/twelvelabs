          "name": "Create a video indexing task",
          "request": {
            "name": "Create a video indexing task",
            "description": {
              "content": "Uploads a video by local file or public URL and indexes it into the target index. Returns a task whose status can be polled until it becomes `ready`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tasks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "index_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Unique identifier of the target index."
                },
                {
                  "key": "video_file",
                  "type": "file",
                  "description": "The video file to upload (use this OR video_url)."
                },
                {
                  "key": "video_url",
                  "value": "<string>",
                  "type": "text",
                  "description": "Publicly accessible URL of the video (use this OR video_file)."
                },
                {
                  "key": "enable_video_stream",
                  "value": "true",
                  "type": "text",
                  "description": "Whether the platform stores the video for streaming."
                },
                {
                  "key": "user_metadata",
                  "value": "<string>",
                  "type": "text",
                  "description": "JSON-encoded user metadata for categorization."
                }
              ]
